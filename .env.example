# ---------------------------------------------------------------------------------------
# CREDIFY ENVIRONMENT VARIABLES
#
# Copy this file to `.env.local` and fill in the real values:
#
#     cp .env.example .env.local
#
# `.env.local` is listed in .gitignore and must never be committed. This file, with empty
# values, IS committed, so anyone cloning the repository can see what is needed.
#
# Note that NEITHER name below starts with NEXT_PUBLIC_. That prefix is what tells Next.js
# to inline a value into the JavaScript it sends to the browser. Without it, these values
# stay on the server and are unreachable from the client, which is exactly what we want for
# a database key.
# ---------------------------------------------------------------------------------------

# Supabase dashboard -> Project Settings -> Data API -> Project URL
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase dashboard -> Project Settings -> API Keys -> `service_role` (click "Reveal")
#
# THIS KEY BYPASSES ALL DATABASE SECURITY RULES. Treat it like a database password:
#   - never commit it
#   - never paste it into client-side code, a browser console, or a chat window
#   - if it is ever exposed, rotate it in the Supabase dashboard immediately
SUPABASE_SERVICE_ROLE_KEY=
